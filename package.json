{
  "name": "profession-search-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "国内求职者的本地优先 AI 求职副驾驶（岗位库 + 经历库 + 匹配 + 材料生成）",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "node scripts/run-tests.mjs",
    "check:adapter": "node scripts/check-adapter-purity.mjs",
    "accept": "node scripts/accept.mjs",
    "verify": "npm run accept",
    "verify:model": "node scripts/verify-model-errors.mjs",
    "verify:idempotency": "node scripts/verify-idempotency.mjs",
    "verify:f02": "node scripts/verify-f02.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@types/pg": "^8.23.1",
    "next": "^15.0.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.9.0",
    "eslint-config-next": "^15.0.0",
    "typescript": "^5.6.0"
  },
  "comments": {
    "runtime": "I0 核心（src/lib/llm、src/lib/env.ts、src/lib/tenant.ts、scripts/*）为零依赖实现，可直接用 Node 24 运行与测试；上面这些依赖用于 Web 层与 F-02 起的 schema 层。",
    "test": "npm test 只跑零依赖核心套件（node:test），因此在无网络环境下也能验收。",
    "lint": "@typescript-eslint/parser 是 eslint.config.mjs 解析 .ts 必需的（曾漏配导致 24 个 Parsing error）。它虽由 eslint-config-next 传递安装，但显式声明可避免上游更新后消失。"
  }
}
