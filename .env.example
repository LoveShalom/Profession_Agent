# =============================================================================
# Profession Search Agent —— 环境变量模板
# 说明：复制为 .env 后按需修改；`npm run setup` 会自动生成本文件（不覆盖已有值）。
#      凡标注「可选」的项留空即可，系统会走降级路径而不是报错。
# =============================================================================

# ---------- 应用 ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_PORT=3000
NODE_ENV=development

# ---------- 数据库（本地 Docker 栈默认值，通常不用改）----------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------- 凭证加密（setup 自动生成，勿手工改动）----------
# 必须是 base64 编码的 32 字节；生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ---------- 模型接入（BYOK）----------
# provider: deepseek | qwen | kimi | glm | siliconflow | openai | ollama | custom
LLM_PROVIDER=deepseek
# 留空则使用该 provider 的内置地址；填了就以你填的为准（含 one-api / new-api / OpenRouter 等中转站）
LLM_BASE_URL=
# 留空 = 规则模式（系统仍可启动，AI 功能显示配置引导）
LLM_API_KEY=
# 留空则使用该 provider 的默认模型
LLM_MODEL=
# 任务级模型偏好（可选）：抽取用便宜模型、生成用强模型
LLM_MODEL_EXTRACT=
LLM_MODEL_GENERATE=
# 自一致性采样次数（1–5），越大置信度越可靠、成本越高
LLM_SAMPLE_K=3

# ---------- Embedding（可选；留空则检索降级为关键词检索）----------
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# ---------- 权限与安全 ----------
# false = 本地单用户（默认，不阻断、无需登录）；true = 多账号（启用 Supabase Auth + RLS）
ENABLE_AUTH=false
# 是否允许私网模型地址（Ollama / vLLM 需要开）
ALLOW_PRIVATE_BASE_URL=false
# 出站白名单额外域名（逗号分隔，通常留空）
EGRESS_EXTRA_HOSTS=

# ---------- 可观测（留空 = 完全关闭遥测，本地默认关闭）----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
